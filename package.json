{
	"name": "resora",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @resora/db --",
		"db:studio": "turbo run db:studio -F @resora/db --",
		"db:generate": "turbo run db:generate -F @resora/db --",
		"db:migrate": "pnpm --dir packages/db run db:migrate",
		"db:check": "pnpm --dir apps/server run db:check",
		"db:check:direct": "pnpm --dir apps/server run db:check:direct",
		"db:start": "docker compose up -d postgres",
		"db:watch": "docker compose up postgres",
		"db:stop": "docker compose stop postgres",
		"db:down": "docker compose down postgres",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "pnpm --dir apps/server run auth:generate",
		"test:smoke": "bun test packages/db/src/connectivity.test.ts",
		"test:identity": "bun test packages/db/src/schema/identity.test.ts packages/db/src/schema/identity.integration.test.ts packages/auth/src/identity.test.ts",
		"test:password-reset": "bun --no-env-file test packages/auth/src/password-recovery.test.ts packages/auth/src/password-reset-mail.test.ts apps/server/src/scripts/reset-password-link.test.ts apps/web/src/features/identity/password-recovery-form.test.ts apps/server/src/auth-env.test.ts",
		"test:auth": "bun test packages/auth/src/pilot.test.ts packages/auth/src/pilot.integration.test.ts packages/auth/src/password-policy.test.ts packages/auth/src/rate-limit.test.ts packages/auth/src/rate-limit.integration.test.ts",
		"test:provision": "bun test packages/api/src/modules/provisioning/provisioning-csv.test.ts packages/api/src/modules/provisioning/sr-provisioning.integration.test.ts",
		"sr:provision": "pnpm --dir apps/server run sr:provision",
		"org:seed": "pnpm --dir apps/server run org:seed",
		"system-admin:bootstrap": "pnpm --dir apps/server run system-admin:bootstrap",
		"auth:reset-link": "pnpm --dir apps/server run auth:reset-link",
		"test:rbac": "bun test packages/api/src/modules/identity/identity-policy.test.ts packages/api/src/modules/identity/identity-policy.integration.test.ts packages/db/src/organization.integration.test.ts",
		"test:system-admin": "bun --no-env-file test packages/auth/src/identity-access.test.ts packages/api/src/modules/identity/identity-policy.test.ts packages/api/src/modules/provisioning/system-admin-bootstrap.test.ts packages/api/src/modules/provisioning/system-admin.integration.test.ts",
		"test:account-lifecycle": "bun --no-env-file test packages/api/src/modules/accounts/account-admin.test.ts packages/api/src/modules/accounts/account-lifecycle.integration.test.ts apps/web/src/features/identity/account-status.test.ts",
		"test:committee": "bun --no-env-file test packages/api/src/modules/committee/committee.test.ts packages/api/src/modules/committee/committee.integration.test.ts apps/web/src/features/committee/committee-ui.test.ts packages/db/src/schema/committee.test.ts packages/api/src/modules/identity/identity-policy.test.ts",
		"test:broadcast": "bun --no-env-file test apps/web/src/features/broadcast/broadcast-ui.test.ts packages/db/src/schema/broadcast.test.ts packages/api/src/modules/broadcast/broadcast.test.ts packages/api/src/modules/broadcast/broadcast.integration.test.ts",
		"test:ui": "bun test packages/ui/src/components/input-group.test.tsx apps/web/src/utils/server-url.test.ts",
		"test:attendance": "bun test packages/api/src/modules/attendance/attendance.test.ts packages/api/src/modules/events/attendance.integration.test.ts",
		"test:check-in": "bun --no-env-file test packages/api/src/modules/check-in/check-in.test.ts packages/api/src/modules/attendance/attendance.test.ts",
		"test:offline": "bun --no-env-file scripts/test-offline.ts",
		"test:loadtest": "bun --no-env-file test tests/resora-loadtest/loadtest.test.ts tests/resora-loadtest/provision-dev.test.ts",
		"verify:pr": "pnpm --filter web exec next typegen && pnpm run lint && pnpm run check-types && pnpm run test:offline && pnpm run test:loadtest && pnpm run build",
		"lint": "biome check .",
		"check": "biome check --write .",
		"test:backup": "bun --no-env-file test apps/server/src/database-backup.test.ts packages/db/scripts/download-backup.integration.test.ts"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@resora/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@10.33.4"
}
