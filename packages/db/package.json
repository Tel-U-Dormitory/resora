{
	"name": "@resora/db",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "pnpm run db:migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "bun run scripts/check-migration.ts && drizzle-kit migrate",
		"db:backup": "bun --no-env-file run scripts/standby.ts backup",
		"db:standby:verify": "bun --no-env-file run scripts/standby.ts verify",
		"db:standby:restore": "bun --no-env-file run scripts/standby.ts restore",
		"db:standby:reconcile": "bun --no-env-file run scripts/standby.ts reconcile",
		"test:standby": "bun --no-env-file test scripts/standby.test.ts scripts/standby.integration.test.ts"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"pg": "^8.23.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@resora/config": "workspace:*",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "catalog:",
		"varlock": "catalog:"
	}
}
