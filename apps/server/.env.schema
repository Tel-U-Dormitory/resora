# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Explicit diagnostic switch; only true/false are accepted. Redeploy API after changing.
# @public @type=enum("true", "false")
AUTH_RATE_LIMIT_ENABLED="true"

# Opt-in request/session latency diagnostics. Redeploy API after changing.
# @public @type=enum("true", "false")
AUTH_PERF_DIAGNOSTICS_ENABLED="false"

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Optional for runtime/local development; preferred by Drizzle Kit migrations.
# @required=false @type=string(minLength=1)
DIRECT_DB_URL=

# Portable per-instance pool tuning; Vercel: 1 connection, 1000 ms idle timeout.
# @public @type=number(integer=true, min=1)
DB_POOL_MAX=10

# @public @type=number(integer=true, min=1)
DB_POOL_IDLE_TIMEOUT_MS=10000

# Optional PEM CA certificate; when set, TLS certificate/hostname verification is required.
# Supply the certificate in the deployment secret store, never a private key.
# @required=false @type=string(minLength=1)
DB_SSL_CA=

# Enable manual SUPERADMIN dump downloads only on the Docker PostgreSQL primary.
# @public @type=enum("true", "false")
DATABASE_BACKUP_ENABLED="false"

# NPM-only ingress credential; never expose to web/build/public env or logs.
# Optional for development/Vercel; required by the persistent production listener.
# @required=false @type=string(minLength=32)
AUTH_PROXY_SECRET=
