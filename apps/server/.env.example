# Synthetic build values only. Copy privately to .private/production/server.env
# and REPLACE secret/database settings before runtime; never use this key for users.
NODE_ENV=production
BETTER_AUTH_SECRET=synthetic-build-only-not-for-runtime-000000000000
BETTER_AUTH_URL=https://telkomdormitory.com
CORS_ORIGIN=https://telkomdormitory.com
DATABASE_URL=postgresql://build:build@127.0.0.1:1/build
AUTH_RATE_LIMIT_ENABLED=true
AUTH_PERF_DIAGNOSTICS_ENABLED=false
DATABASE_BACKUP_ENABLED=false
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=10000
# Production: set DB_SSL_CA to the project CA PEM (quoted multiline env value).
# With DB_SSL_CA, DATABASE_URL must have NO ssl/sslmode/sslrootcert/sslcert/sslkey params.
# DIRECT_DB_URL is intentionally absent; migrations are separate operational steps.

# Persistent production runtime requires AUTH_PROXY_SECRET (>=32 random characters).
# Set privately to the same value as NPM's X-Resora-Proxy-Token header.
# Intentionally absent from this build template; never set NEXT_PUBLIC_* for it.
