# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Absolute backend URL for existing dev/Docker; use / for same-origin browser routing.
# @public @type=string(minLength=1)
NEXT_PUBLIC_SERVER_URL=

# Server-only non-secret origin for /api/auth/* and /trpc/* rewrites.
# @public @required=false @type=url
API_UPSTREAM_URL=

# Server-only non-secret API URL for SSR session queries.
# @public @required=false @type=url
SERVER_URL=
