# Source/config files use LF on Windows and Linux; no global renormalization.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf

# Preserve generator-owned files and applied migration artifacts byte-for-byte.
apps/server/src/env.ts -text
apps/web/src/env.ts -text
packages/db/src/env.ts -text
apps/web/next-env.d.ts -text
packages/db/src/migrations/** -text
